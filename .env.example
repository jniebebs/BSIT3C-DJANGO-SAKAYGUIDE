# SakayGuide environment settings
#
# Copy this file to ".env" in the project root and fill in your own values.
# Never commit the real .env file (it is already listed in .gitignore).
# Real process environment variables take precedence over this file.

# Browser key for Google Maps JavaScript API + Directions API.
# Restrict it by HTTP referrer and by API in Google Cloud before using it.
GOOGLE_MAPS_API_KEY=

# Optional Google Maps language / region hints.
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_REGION=PH

# One-time administrator bootstrap (written by `python manage.py create_admin`).
# Keep the real .env private, sign in, change the password, then delete the
# INITIAL_ADMIN_PASSWORD line. Django's `createsuperuser` command is an
# alternative that never writes the password to a file.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Password reset e-mail
# ---------------------------------------------------------------------------
# The console backend prints the reset e-mail to the terminal, so the flow
# works in development without SMTP credentials. Switch to the SMTP backend
# for a real deployment.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=SakayGuide <no-reply@sakayguide.local>

# Set to True when the site is served over HTTPS. Secure session and CSRF
# cookies are then only sent over an encrypted connection.
SECURE_COOKIES=False

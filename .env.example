# SakayGuide environment settings
#
# Copy this file to ".env" in the project root and fill in your own values.
# Never commit the real .env file (it is already listed in .gitignore).
# Real process environment variables take precedence over this file.

# Browser key for Google Maps JavaScript API + Directions API.
# Restrict it by HTTP referrer and by API in Google Cloud before using it.
GOOGLE_MAPS_API_KEY=

# Optional Google Maps language / region hints.
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_REGION=PH
